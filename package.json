  "license": "MIT",
  "scripts": {
    "start": "node bin/cli.js",
    "setup": "node bin/cli.js setup",
    "dev": "npm --prefix web run dev",
    "build": "npm --prefix web run build"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "^8.22.2"
  }
