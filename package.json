{
  "name": "@webskr/voicebridge",
  "version": "1.3.0",
  "description": "Turn your mobile phone into an AI-powered Voice Typing Companion, Virtual Trackpad & 3,000+ line Clipboard Injector for AI IDEs",
  "main": "bin/cli.js",
  "bin": {
    "voicebridge": "bin/cli.js",
    "voicebridge-mcp": "bin/cli.js"
  },
  "files": [
    "bin",
    "lib",
    "skills",
    "web/dist",
    "mcp_config.json",
